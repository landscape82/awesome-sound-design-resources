{
  "name": "awesome-sound-design-resources",
  "version": "1.0.0",
  "private": true,
  "description": "Tooling for linting and maintaining the Awesome Sound Design resources list.",
  "scripts": {
    "lint": "awesome-lint",
    "validate": "node .github/scripts/validate.mjs",
    "lint:md": "markdownlint README.md CONTRIBUTING.md",
    "lint:links": "markdown-link-check README.md --config .markdown-link-check.json"
  },
  "devDependencies": {
    "awesome-lint": "^2.3.0",
    "markdown-link-check": "^3.15.0",
    "markdownlint-cli": "^0.50.0"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "re2js": "^2.8.7",
    "katex": "^0.18.2",
    "minimatch@>=10": "^11.0.1",
    "basic-ftp": "^6.2.1"
  }
}
